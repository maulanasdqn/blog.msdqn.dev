{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msdqn-blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "blog.msdqn.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "msdqn-dev",
      "database_id": "aecc5320-304d-46a3-8316-2ca74ed79935",
      "remote": true
    }
  ]
}
