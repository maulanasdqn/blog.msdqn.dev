---
import SectionHeading from "@/components/section-heading.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { countTags, listPosts } from "@/lib/posts";
import { tagSlug } from "@/lib/site";

const tags = countTags(await listPosts());
---

<BaseLayout
  title="Tags | Maulana Sodiqin"
  description="Browse posts by topic."
  noindex={tags.size === 0}
>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-20 sm:px-8 sm:pt-28">
    <h1
      class="mb-16 text-5xl font-medium leading-[1.05] tracking-tight text-mono-text"
    >
      Tags
    </h1>
    <SectionHeading title={`${tags.size} topics`} />
    {
      tags.size === 0 ? (
        <p class="text-mono-subtle">No tags yet.</p>
      ) : (
        <ul class="grid grid-cols-1 gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
          {[...tags].map(([tag, count]) => (
            <li class="border-b border-mono-line">
              <a
                href={`/tags/${tagSlug(tag)}`}
                class="flex items-baseline justify-between py-4 text-mono-text transition-colors hover:text-mono-subtle"
              >
                <span>#{tag}</span>
                <span class="text-sm text-mono-muted tabular-nums">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
