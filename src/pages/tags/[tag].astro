---
import PostRow from "@/components/post-row.astro";
import SectionHeading from "@/components/section-heading.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { listPosts, postsWithTag } from "@/lib/posts";
import { MIN_INDEXED_TAG_POSTS, SITE_URL, tagSlug } from "@/lib/site";

const slug = Astro.params.tag ?? "";
const posts = postsWithTag(await listPosts(), slug);

if (posts.length === 0) {
  return Astro.rewrite("/404");
}

const label = posts[0].tags.find((tag) => tagSlug(tag) === slug) ?? slug;
const url = `${SITE_URL}/tags/${slug}`;
const description = `${posts.length} post${posts.length === 1 ? "" : "s"} about ${label} by Maulana Sodiqin: ${posts
  .slice(0, 3)
  .map((post) => post.title)
  .join("; ")}.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}#page`,
      url,
      name: `#${label}`,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${SITE_URL}/#website` },
      about: { "@type": "Thing", name: label },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: posts.map((post, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `${SITE_URL}/blog/${post.slug}`,
          name: post.title,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Writing", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "Tags", item: `${SITE_URL}/tags` },
        { "@type": "ListItem", position: 3, name: `#${label}`, item: url },
      ],
    },
  ],
};
---

<BaseLayout
  title={`#${label} | Maulana Sodiqin`}
  description={description}
  jsonLd={jsonLd}
  noindex={posts.length < MIN_INDEXED_TAG_POSTS}
>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-20 sm:px-8 sm:pt-28">
    <p
      class="mb-10 text-xs font-medium uppercase tracking-[0.14em] text-mono-muted"
    >
      <a href="/tags" class="transition-colors hover:text-mono-text">Tags</a>
    </p>
    <h1
      class="mb-16 text-5xl font-medium leading-[1.05] tracking-tight text-mono-text"
    >
      #{label}
    </h1>
    <SectionHeading
      title={`${posts.length} post${posts.length === 1 ? "" : "s"}`}
    />
    {posts.map((post) => <PostRow post={post} />)}
  </section>
</BaseLayout>
