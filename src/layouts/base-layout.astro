---
import BaseHead from "../components/base-head.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="moon">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
