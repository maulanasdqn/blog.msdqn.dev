---
import type { Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, readingTime } = post.data as typeof post.data & { readingTime?: number };
const formattedDate = pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<article class="post-card">
  <a href={`/blog/${post.id}`} class="post-link">
    <h2>{title}</h2>
    <p class="description">{description}</p>
  </a>
  <div class="meta">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    {readingTime && <span>{readingTime} min read</span>}
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag">#{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--overlay);
  }

  .post-link {
    display: block;
    color: inherit;
  }

  .post-link:hover { text-decoration: none; }

  .post-link h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    color: var(--text);
    transition: color 0.15s;
  }

  .post-link:hover h2 { color: var(--iris); }

  .description {
    color: var(--subtle);
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--muted);
    flex-wrap: wrap;
  }

  .tags { display: flex; gap: 0.5rem; }

  .tag {
    color: var(--iris);
    font-size: 0.8rem;
  }

  .tag:hover { color: var(--foam); text-decoration: none; }
</style>
