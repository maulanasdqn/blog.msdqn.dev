---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth <= 3);
---

{filtered.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <h2>Contents</h2>
    <ul>
      {filtered.map((h) => (
        <li class={`toc-h${h.depth}`}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    background: var(--surface);
    border: 1px solid var(--overlay);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    font-size: 0.875rem;
  }

  .toc h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li { margin-bottom: 0.3rem; }
  .toc-h3 { padding-left: 1rem; }

  a { color: var(--subtle); }
  a:hover { color: var(--iris); }
</style>
