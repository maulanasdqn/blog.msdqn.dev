---
import type { Heading } from "@/lib/markdown";

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 1 && (
    <nav class="toc text-sm" aria-label="Table of contents">
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.14em] text-mono-muted">
        On this page
      </p>
      <ul class="space-y-2.5 border-l border-mono-line">
        {headings.map((heading) => (
          <li class={heading.depth === 3 ? "pl-7" : "pl-4"}>
            <a
              href={`#${heading.slug}`}
              class="-ml-px block border-l border-transparent pl-0 leading-snug text-mono-muted transition-colors hover:text-mono-text"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']"),
  );
  const byId = new Map(
    links.map((link) => [
      decodeURIComponent(link.hash.slice(1)),
      link,
    ]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) link.removeAttribute("aria-current");
        byId.get(entry.target.id)?.setAttribute("aria-current", "true");
      }
    },
    { rootMargin: "0px 0px -75% 0px" },
  );
  for (const id of byId.keys()) {
    const heading = document.getElementById(id);
    if (heading) observer.observe(heading);
  }
</script>

<style>
  .toc a[aria-current] {
    color: #fafafa;
  }
</style>
