---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth <= 3);
---

{filtered.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <h2>Contents</h2>
    <ul>
      {filtered.map((h) => (
        <li class={`toc-h${h.depth}`}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    background: var(--surface);
    border: 1px solid var(--overlay);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    font-size: 0.875rem;
  }

  .toc h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li { margin-bottom: 0.3rem; }
  .toc-h3 { padding-left: 1rem; }

  a { color: var(--subtle); transition: color 0.15s; }
  a:hover { color: var(--iris); }

  a.active {
    color: var(--iris);
    border-left: 2px solid var(--iris);
    padding-left: 0.35rem;
    margin-left: -0.35rem;
  }
</style>

<script>
  function initScrollSpy() {
    const toc = document.querySelector(".toc");
    if (!toc) return;

    const links = Array.from(
      toc.querySelectorAll("a[href^='#']")
    ) as HTMLAnchorElement[];
    if (!links.length) return;

    const linkMap = new Map(
      links.map((a) => [
        decodeURIComponent(a.getAttribute("href")!.slice(1)),
        a,
      ])
    );

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = linkMap.get(entry.target.id);
          if (link) link.classList.toggle("active", entry.isIntersecting);
        }
      },
      { rootMargin: "0px 0px -80% 0px", threshold: 0 }
    );

    for (const id of linkMap.keys()) {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    }

    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      { once: true }
    );
  }

  initScrollSpy();
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
