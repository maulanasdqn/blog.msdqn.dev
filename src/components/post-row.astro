---
import type { Post } from "@/lib/posts";
import { formatDate, tagSlug } from "@/lib/site";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article
  class="group grid grid-cols-1 gap-2 border-b border-mono-line py-8 first:pt-0 md:grid-cols-12 md:gap-8"
>
  <p class="pt-1.5 text-xs text-mono-muted tabular-nums md:col-span-3">
    <time datetime={post.publishedAt.toISOString()}>
      {formatDate(post.publishedAt)}
    </time>
    <span aria-hidden="true"> · </span>
    {post.readTime} min read
  </p>
  <div class="md:col-span-9">
    <h2 class="text-2xl font-medium tracking-tight text-mono-text">
      <a
        href={`/blog/${post.slug}`}
        class="underline decoration-transparent underline-offset-[6px] transition-colors group-hover:decoration-mono-line-strong"
      >
        {post.title}
      </a>
    </h2>
    {
      post.excerpt && (
        <p class="mt-3 line-clamp-3 leading-relaxed text-mono-subtle">
          {post.excerpt}
        </p>
      )
    }
    {
      post.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {post.tags.map((tag) => (
            <li>
              <a
                href={`/tags/${tagSlug(tag)}`}
                class="text-mono-muted transition-colors hover:text-mono-text"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
