---
const path = Astro.url.pathname;
const links = [
  { label: "Posts", href: "/" },
  { label: "Tags", href: "/tags" },
  { label: "Search", href: "/search" },
];
---

<header
  class="sticky top-0 z-50 border-b border-mono-line bg-mono-bg/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6 sm:px-8"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-baseline gap-2 text-mono-text">
      <span class="text-lg font-medium tracking-tight">Maulana Sodiqin</span>
      <span class="text-sm text-mono-muted">/ writing</span>
    </a>
    <div class="flex items-center gap-5 text-sm sm:gap-7">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              (link.href === "/" ? path === "/" : path.startsWith(link.href))
                ? "page"
                : undefined
            }
            class="text-mono-subtle transition-colors hover:text-mono-text aria-[current=page]:text-mono-text"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://msdqn.dev"
        class="hidden text-mono-text underline decoration-mono-line-strong underline-offset-[6px] transition-colors hover:decoration-mono-text sm:inline"
      >
        msdqn.dev
      </a>
    </div>
  </nav>
</header>
