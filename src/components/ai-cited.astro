    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.709 15.955l4.397-2.85-.93-1.86-6.078 3.24a.903.903 0 00-.398.534.852.852 0 00.074.65l3.239 5.6a.896.896 0 001.222.322l1.582-.91-3.108-4.726zm12.633-2.85l4.397 2.85-3.108 4.727 1.582.91a.9.9 0 001.222-.322l3.239-5.6a.848.848 0 00.074-.65.903.903 0 00-.398-.534l-6.078-3.24-.93 1.86zm-5.37-9.97L7.47 6.08l5.502 3.378 5.502-3.378-4.503-2.945a.892.892 0 00-.996 0zM12.973 24h-1.946a.91.91 0 01-.91-.91v-6.468l-6.09-3.578L2.08 14.59.498 13.672a.912.912 0 01-.46-.546.863.863 0 01.072-.691l.97-1.667 6.082 3.572V8.503L1.08 4.93a.91.91 0 01-.334-1.244l.97-1.672a.91.91 0 01.766-.424.91.91 0 01.478.134l1.582.915L6.49 1.09A2.756 2.756 0 018.917 0h6.166a2.756 2.756 0 012.427 1.09l1.948 1.549 1.582-.915a.91.91 0 01.478-.134.906.906 0 01.766.424l.97 1.672a.91.91 0 01-.334 1.244l-6.082 3.573v5.837l6.082-3.572.97 1.667a.863.863 0 01.072.691.912.912 0 01-.46.546l-1.582.918-1.948 1.546-6.09 3.578v6.467a.91.91 0 01-.908.91z"/></svg>`,
