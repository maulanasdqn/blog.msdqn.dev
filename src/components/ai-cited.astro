---

<div class="not-prose mt-10 border-t border-mono-line pt-6">
  <p
    class="mb-5 text-xs font-medium uppercase tracking-[0.14em] text-mono-subtle"
  >
    Ask AI about this post
  </p>
  <div class="flex flex-wrap gap-3">
    {
      engines.map((engine) => (
        <a
          href={engine.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-2 rounded-md border border-mono-line bg-mono-surface px-3 py-2 text-sm text-mono-muted no-underline transition-colors hover:border-mono-line-strong hover:text-mono-subtle"
        >
          <span
            class="h-4 w-4 shrink-0 text-mono-muted transition-colors group-hover:text-mono-subtle"
            set:html={engine.icon}
          />
          {engine.name}
        </a>
      ))
    }
  </div>
</div>
