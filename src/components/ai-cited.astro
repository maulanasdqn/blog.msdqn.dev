  {
    name: "Gemini",
    href: `https://gemini.google.com/app?q=${prompt}`,
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.352 0 0 5.352 0 12s5.352 12 12 12 12-5.352 12-12S18.648 0 12 0zm0 2.4c5.28 0 9.6 4.32 9.6 9.6s-4.32 9.6-9.6 9.6-9.6-4.32-9.6-9.6 4.32-9.6 9.6-9.6zm0 1.464A8.148 8.148 0 0 0 3.864 12 8.148 8.148 0 0 0 12 20.136 8.148 8.148 0 0 0 20.136 12 8.148 8.148 0 0 0 12 3.864z"/></svg>`,
  },
  {
    name: "Copilot",
    href: `https://copilot.microsoft.com/?q=${prompt}`,
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.922 12.397a2.269 2.269 0 0 0-.551-1.097L21 8.785V7a5.001 5.001 0 0 0-8.684-3.373L12 3.96l-.316-.333A5.001 5.001 0 0 0 3 7v1.785L.629 11.3a2.28 2.28 0 0 0-.55 1.097A2.727 2.727 0 0 0 0 12.9v.3a2.8 2.8 0 0 0 2.8 2.8H3v1a4 4 0 0 0 4 4h2a1 1 0 0 0 1-1v-4H8a1 1 0 0 1-1-1V9.87l4.383-4.6a.875.875 0 0 1 1.234 0L17 9.87V15a1 1 0 0 1-1 1h-2v4a1 1 0 0 0 1 1h2a4 4 0 0 0 4-4v-1h.2a2.8 2.8 0 0 0 2.8-2.8v-.3a2.727 2.727 0 0 0-.078-.503z"/></svg>`,
